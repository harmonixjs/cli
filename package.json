{
  "name": "@harmonixjs/cli",
  "version": "2.0.0",
  "description": "CLI for Harmonix Discord framework",
  "bin": {
    "harmonix": "./bin/harmonix.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/clean.js && tsc",
    "dev": "tsc --watch",
    "test": "node scripts/smoke-test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "harmonix",
    "discord",
    "cli",
    "generator",
    "bot"
  ],
  "author": "Maxence Bessi",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "execa": "^8.0.0",
    "fs-extra": "^11.2.0",
    "gradient-string": "^2.0.2",
    "inquirer": "^9.2.0"
  },
  "devDependencies": {
    "@harmonixjs/core": "file:../core",
    "@types/fs-extra": "^11.0.0",
    "@types/gradient-string": "^1.1.6",
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.0.0",
    "discord.js": "^14.26.4",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
